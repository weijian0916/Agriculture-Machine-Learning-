#svm
set.seed(123)
train_idx <- sample(nrow(df_supervised), 1000) #choose 1000 data to train
train_data <- df_supervised[train_idx, ]
test_data  <- df_supervised[-train_idx, ]
svm_model <- svm(yields ~ ., data = train_data, 
                 kernel = "radial", cost = 1, gamma = 0.1, scale = TRUE) #cost 1 is the most commom and scale is to standardlise
summary(svm_model)

preds <- predict(svm_model, test_data)
conf_mat <- table(Predicted = preds, Actual = test_data$yields)
print(conf_mat)
print(confusionMatrix(preds, test_data$yields))

# Automatic tuning try to find the best model and try to get the best gamma and cost
tuned <- tune.svm(yields ~ ., data = train_data, gamma = 10^(-3:0), cost = 10^(0:2))
print(tuned)
best_model <- tuned$best.model
best_pred <- predict(best_model, newdata = test_data)
final_result <- confusionMatrix(best_pred, test_data$yields)
print(final_result)
#gamma=1 cost=1

# ranfom forest
rf_model <- randomForest(yields ~ ., data = train_data, ntree = 500)
rf_pred <- predict(rf_model, newdata = test_data)
confusionMatrix(rf_pred, test_data$yields)

#rule based
tree_model <- rpart(yields ~ ., data = train_data, method = "class",control = rpart.control(cp = 0.001))
printcp(tree_model)
best_cp <- tree_model$cptable[which.min(tree_model$cptable[,"xerror"]), "CP"]
tree_pruned <- prune(tree_model, cp = best_cp)
plot(as.party(tree_pruned), main="Pruned Decision Tree for yields Prediction")
rules <- asRules(tree_pruned)
print(rules)
tree_preds <- predict(tree_pruned, test_data, type = "class")
print(confusionMatrix(tree_preds, test_data$yields))


